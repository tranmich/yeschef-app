 * Activity status labels
 */
export const ACTIVITY_STATUS_LABELS = {
  viewing: 'Viewing',
  editing: 'Editing',
  commenting: 'Commenting',
};

console.log('✅ Liveblocks configured with auth endpoint:', `${API_BASE_URL}/api/v2/liveblocks/auth`);
