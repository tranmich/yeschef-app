/* RecipeDetailModal.css - Single Column Recipe Display */

.recipe-detail-modal {
  background: white;
  border-radius: 16px;
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2);
  max-width: 800px;
  width: 95vw;
  max-height: 90vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* Header Section */
.recipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 32px 16px 32px;
  border-bottom: 1px solid #e5e7eb;
  background: #fafafa;
  border-radius: 16px 16px 0 0;
}

.recipe-title-section {
  flex: 1;
}

.recipe-title-large {
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
  color: #111827;
  line-height: 1.2;
  text-align: left;
}

.close-button {
  background: #f3f4f6;
  border: none;
  border-radius: 8px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 18px;
  color: #6b7280;
  transition: all 0.2s ease;
}

.close-button:hover {
  background: #e5e7eb;
  color: #374151;
}

/* Recipe Metadata Bar */
.recipe-metadata-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding: 16px 32px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.metadata-item {
  display: flex;
  align-items: center;
  gap: 6px;
  background: white;
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  font-size: 14px;
}

.metadata-icon {
  font-size: 16px;
}

.metadata-label {
  color: #6b7280;
  font-weight: 500;
}

.metadata-value {
  color: #111827;
  font-weight: 600;
}

/* Recipe Content Flow */
.recipe-content-flow {
  padding: 24px 32px;
  flex: 1;
}

.recipe-section {
  margin-bottom: 32px;
}

.recipe-section:last-child {
  margin-bottom: 0;
}

.recipe-description {
  font-size: 16px;
  line-height: 1.6;
  color: #4b5563;
  margin: 0 0 24px 0;
  font-style: italic;
}

.section-title {
  font-size: 1.5rem;
  font-weight: 600;
  color: #111827;
  margin: 0 0 16px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-content {
  background: #f9fafb;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
  overflow: hidden;
}

.formatted-recipe-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 15px;
  line-height: 1.7;
  color: #374151;
  white-space: pre-wrap;
  margin: 0;
  padding: 20px;
  background: transparent;
  border: none;
  max-width: 100%;
  overflow-wrap: break-word;
}

/* Action Buttons */
.recipe-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  padding-top: 24px;
  border-top: 1px solid #e5e7eb;
  margin-top: 24px;
}

.action-button {
  padding: 10px 20px;
  border-radius: 8px;
  border: 1px solid #d1d5db;
  background: white;
  color: #374151;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.action-button:hover {
  background: #f3f4f6;
  border-color: #9ca3af;
}

.edit-button {
  background: #3b82f6;
  color: white;
  border-color: #3b82f6;
}

.edit-button:hover {
  background: #2563eb;
  border-color: #2563eb;
}

.close-button-secondary {
  background: #6b7280;
  color: white;
  border-color: #6b7280;
}

.close-button-secondary:hover {
  background: #4b5563;
  border-color: #4b5563;
}
  border-bottom: 1px solid #e9ecef;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
}

.recipe-title-section {
  flex: 1;
  margin-right: 20px;
}

.recipe-title {
  margin: 0 0 8px;
  color: #2c3e50;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.2;
}

.recipe-description {
  margin: 0;
  color: #6c757d;
  font-size: 16px;
  line-height: 1.4;
  font-style: italic;
}

.recipe-header-actions {
  display: flex;
  gap: 12px;
  align-items: center;
}

.edit-button {
  background: #007bff;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
}

.edit-button:hover {
  background: #0056b3;
}

.close-button {
  background: #dc3545;
  color: white;
  border: none;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-button:hover {
  background: #c82333;
}

/* Info Bar */
.recipe-info-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  padding: 16px 32px;
  background: #f8f9fa;
  border-bottom: 1px solid #e9ecef;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
}

.info-icon {
  font-size: 16px;
}

.info-label {
  color: #6c757d;
  font-weight: 600;
}

.info-value {
  color: #2c3e50;
  font-weight: 700;
}

/* Tab Navigation */
.recipe-tabs {
  display: flex;
  border-bottom: 1px solid #e9ecef;
  background: white;
  padding: 0 32px;
  overflow-x: auto;
}

.tab-button {
  background: none;
  border: none;
  padding: 16px 20px;
  font-size: 14px;
  font-weight: 600;
  color: #6c757d;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  transition: all 0.2s;
  white-space: nowrap;
}

.tab-button:hover {
  color: #007bff;
  background: rgba(0, 123, 255, 0.05);
}

.tab-button.active {
  color: #007bff;
  border-bottom-color: #007bff;
}

/* Content Area */
.recipe-content {
  flex: 1;
  overflow-y: auto;
  padding: 24px 32px;
}

.tab-content {
  animation: fadeIn 0.2s ease-in;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Overview Tab */
.overview-tab {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}

.overview-section h3 {
  margin: 0 0 16px;
  color: #2c3e50;
  font-size: 18px;
  font-weight: 700;
}

/* Ingredients Preview */
.ingredients-preview {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ingredient-preview {
  padding: 8px 12px;
  background: #f8f9fa;
  border-radius: 6px;
  font-size: 14px;
  color: #495057;
}

.ingredient-preview.more {
  font-style: italic;
  color: #6c757d;
  text-align: center;
}

/* Instructions Preview */
.instructions-preview {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.instruction-preview {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: #f8f9fa;
  border-radius: 8px;
}

.step-number {
  background: #007bff;
  color: white;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: bold;
  flex-shrink: 0;
}

.step-text {
  color: #495057;
  font-size: 14px;
  line-height: 1.4;
}

.instruction-preview.more {
  justify-content: center;
  font-style: italic;
  color: #6c757d;
}

/* Ingredients Tab */
.ingredients-tab h3 {
  margin: 0 0 20px;
  color: #2c3e50;
  font-size: 20px;
  font-weight: 700;
}

.ingredients-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 12px;
}

.ingredient-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 16px;
  background: #f8f9fa;
  border-radius: 8px;
  border-left: 4px solid #28a745;
}

.ingredient-bullet {
  color: #28a745;
  font-weight: bold;
  font-size: 16px;
}

.ingredient-text {
  color: #495057;
  font-size: 15px;
  line-height: 1.4;
}

/* Instructions Tab */
.instructions-tab h3 {
  margin: 0 0 20px;
  color: #2c3e50;
  font-size: 20px;
  font-weight: 700;
}

.instructions-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.instruction-item {
  display: flex;
  gap: 16px;
  padding: 20px;
  background: #f8f9fa;
  border-radius: 12px;
  border-left: 4px solid #007bff;
}

.instruction-number {
  background: #007bff;
  color: white;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
  flex-shrink: 0;
}

.instruction-text {
  color: #495057;
  font-size: 15px;
  line-height: 1.6;
  flex: 1;
}

/* Source Tab */
.source-tab h3 {
  margin: 0 0 20px;
  color: #2c3e50;
  font-size: 20px;
  font-weight: 700;
}

.source-info {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.source-url,
.source-author,
.source-method,
.source-imported {
  padding: 16px;
  background: #f8f9fa;
  border-radius: 8px;
  border-left: 4px solid #17a2b8;
}

.source-link {
  color: #007bff;
  text-decoration: none;
  word-break: break-all;
  display: block;
  margin-top: 4px;
}

.source-link:hover {
  text-decoration: underline;
}

/* No Content Message */
.no-content {
  text-align: center;
  color: #6c757d;
  font-style: italic;
  padding: 40px 20px;
  background: #f8f9fa;
  border-radius: 8px;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .recipe-detail-modal {
    width: 100vw;
    height: 100vh;
    max-height: 100vh;
    border-radius: 0;
  }

  .recipe-header {
    padding: 20px;
    flex-direction: column;
    gap: 16px;
  }

  .recipe-header-actions {
    width: 100%;
    justify-content: space-between;
  }

  .recipe-title {
    font-size: 24px;
  }

  .recipe-info-bar {
    padding: 16px 20px;
    justify-content: center;
  }

  .recipe-tabs {
    padding: 0 20px;
  }

  .recipe-content {
    padding: 20px;
  }

  .overview-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .ingredients-list {
    grid-template-columns: 1fr;
  }

  .instruction-item {
    flex-direction: column;
    text-align: center;
    gap: 12px;
  }

  .tab-button {
    font-size: 12px;
    padding: 12px 16px;
  }
}

@media (max-width: 480px) {
  .recipe-header {
    padding: 16px;
  }

  .recipe-info-bar {
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .info-item {
    justify-content: center;
  }

  .recipe-content {
    padding: 16px;
  }

  .tab-button {
    font-size: 11px;
    padding: 10px 12px;
  }
}

/* Formatted Text Content Styles */
.formatted-text-content {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #374151;
  white-space: pre-wrap;
  margin: 0;
  padding: 16px;
  background: #f9fafb;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
  max-width: 100%;
  overflow-wrap: break-word;
}

.formatted-text-content:hover {
  background: #f3f4f6;
  border-color: #d1d5db;
  transition: all 0.2s ease;
}

/* Formatted preview text for overview sections */
.formatted-preview-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px;
  line-height: 1.5;
  color: #4b5563;
  white-space: pre-wrap;
  margin: 0;
  padding: 12px;
  background: #f8fafc;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
  max-width: 100%;
  overflow-wrap: break-word;
  max-height: 200px;
  overflow-y: auto;
}

/* Dark theme support for formatted text */
@media (prefers-color-scheme: dark) {
  .formatted-text-content {
    background: #1f2937;
    color: #e5e7eb;
    border-color: #374151;
  }
  
  .formatted-text-content:hover {
    background: #111827;
    border-color: #4b5563;
  }
  
  .formatted-preview-text {
    background: #1e293b;
    color: #cbd5e1;
    border-color: #334155;
  }
}
